            <main class="main-content" id="MainContent">
              <div id="shopify-section-template--17462436528337__main-collection" class="shopify-section"><style>
  .collection-description.rte {
    text-align: left;
  }
  .collection-description.rte a.read-more.btn{
    margin:20px 0 0;
  }
  .load-more_wrap {
    text-align: center;
  }
  div#truncated {
    width: 100%;
  }
  .pagination{
    display:none;
  }
  [data-animate_images=true] .image-wrap img:not([role=presentation]) {
    opacity: 1 !important;
  }
  /* New collection page css start */
  #CollectionAjaxContent .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 30px;
    margin: 0;
  }
  #CollectionAjaxContent .grid .grid__item {
    width: 100%;
    padding: 0;
  }
  #CollectionAjaxContent .grid  .video-and-image.product {
    grid-column: 3 / span 2;
    grid-row: 2 / 2;
  }
  .video-and-image.product .video-box {
    position: relative;
    padding-top: calc(100% - 40px);
  }
  .video-box iframe, .video-box video {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
  }
  /* New collection page css End */
  .collection-filter {
    display: block;
    width: 75%;
    float: left;
  }
  .collection-filter .grid.grid--uniform .grid__item:first-child {
    display: none;
  }
  .collection-filter .grid.grid--uniform .grid__item:last-child {
    width: 100%;
  }
  div#CollectionAjaxResult {
    display: inline-block;
  }
  .grid-product__content span.custom-tag {
    position: absolute;
    z-index: 1;
    background-color: #000;
    color: #fff;
    right: 0;
    top: 0;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 12px;
    padding: 7px 8px 7px 10px;
  }
  @media screen and (min-width:991px){
    div#FilterDrawer .drawer__scrollable {
      opacity: 1;
      transform: none;
    }
    div#FilterDrawer .drawer__header {
      opacity: 1;
      transform: none;
    }
    div#FilterDrawer {
      position: relative;
      width: 100%;
      left: 0;
      transform: none;
      max-width: 100%;
      display: block;
      opacity: 1;
      visibility: visible;
      z-index: 1;
    }
    div#CollectionSidebar {
      width: 25%;
      float: left;
    }
    div#CollectionAjaxResult {
      width: 75%;
      float: left;
    }
    .collection-description.rte {
      display: table;
      padding: 50px 0 0;
    }
    #CollectionSection .hr--clear {
      border: 0;
      width: 100%;
    }
    #FilterDrawer .drawer__close {
      display: none;
    }
    .addReadMore.showlesscontent .SecSec,
    .addReadMore.showlesscontent .readLess {
      display: none;
    }
    .addReadMore.showmorecontent .readMore {
      display: none;
    }
    .addReadMore .readMore,
    .addReadMore .readLess {
      font-weight: bold;
      margin-left: 2px;
      color: blue;
      cursor: pointer;
    }
    .addReadMoreWrapTxt.showmorecontent .SecSec,
    .addReadMoreWrapTxt.showmorecontent .readLess {
      display: block;
    }
  }

  .collection-hero__content{
    position: unset;
    padding:0;
    color:#000 !important;
  }

  @media screen and (max-width: 991px) {
    #CollectionAjaxContent .grid{
      grid-template-columns: repeat(3, 1fr);
    }
    #CollectionAjaxContent .grid .video-and-image.product{
      grid-column: 2 / span 2;
    }
    .collection-filter .grid.grid--uniform .grid__item:first-child {
      display: block;
    }
    .collection-filter {
      width: 100%;
    }
    .collection-filter .grid.grid--uniform .grid__item:last-child {
      width: 50%;
    }
  }

  @media screen and (max-width:767px){
    img.collection-hero__image {
      opacity: 1 !important;
      height: auto;
      width: 100%;
    }
    .collection-hero__content {
      align-items: center;
      position: relative;
    }
    .collection-hero__content .page-width {
      width: 100%;
      padding: 0;
    }
    body .collection-hero {
      height: auto;
    }
    #CollectionAjaxContent .grid{
      grid-template-columns: repeat(2, 1fr);
    }
    #CollectionAjaxContent .grid .video-and-image.product{
      grid-column: 1 / span 2;
    }
    .video-and-image.product .video-box {
      padding-top: calc(100% - 30px);
      margin-bottom: 30px;
    }
  }

  @media screen and (max-width: 420px) {
    .collection-filter .grid.grid--uniform .grid__item:first-child {
      width: 120px;
    }
    .collection-filter .btn {
      padding: 0 10px;
    }
    .collection-filter .grid.grid--uniform .grid__item:last-child {
      width: calc(100% - 120px);
    }
  }

  #AjaxinatePagination {
    text-align: center;
  }
  .svg-loader-collection {
    width: 40px;
    max-width: 40px;
    height: auto;
    margin: 0px auto;
  }
  .collection_top_head{
    display:flex;
    align-items:center;
    justify-content: space-between;
    margin: 0 0 30px 30px;
  }
  .breadcrumb{
    margin-bottom: 0;
  }

  @media screen and (max-width: 500px) {
    .collection_top_head{
      align-items: flex-start;
      flex-direction: column-reverse;
      margin: 0 0 30px 0;
    }
  }
</style>

