<style>

/* ===============================
GLOBAL TYPOGRAPHY CONTROL
================================ */

:root{
  --typeHeaderSize: 18px;
  --typeBaseSize: 10px;
}

/*---------- Popup CSS Start ----------*/

.popup-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 99;
}

#prototype-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  padding: 20px 15px 20px;
  border-radius: 8px;
  width: 94%;
  max-width: 700px;
  box-shadow: 0 10px 35px rgba(0,0,0,0.25);
  z-index: 999;
  height: calc(100vh - 40px);
  max-height: 600px;
  display: none;
}

.popup-content {
  height: 100%;
  overflow-y: auto;
}

.spv-ic svg {
  height: 34px;
}

/* Scrollbar */

.popup-content::-webkit-scrollbar {
  width: 6px;
}

.popup-content::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 10px;
}

/* Close Button */

.close-btn {
  position: absolute;
  top: -12px;
  right: -8px;
  font-weight: 700;
  font-size: calc(var(--typeHeaderSize) * 0.9);
  cursor: pointer;
  background: #000;
  color: #fff;
  width: 28px;
  height: 28px;
  text-align: center;
  border-radius: 50%;
  line-height: 28px;
}

.prototype-popup-active .popup-overlay,
.prototype-popup-active #prototype-popup {
  display: block;
}

.prototype-popup-active {
  overflow: hidden;
}

/* Agree Button */

.js-prototype-agree {
  background: #0b2a5b;
  color: #fff;
  padding: 10px 30px;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 600;
  font-size: calc(var(--typeHeaderSize) * 0.72);
  transition: 0.3s;
}

.js-prototype-agree:hover {
  background: #ff7a00;
}

/*---------- Popup CSS End ----------*/


/* ===============================
SYLVI PROTOTYPE – PREMIUM EXACT
================================ */

.spv-576{
  font-family:'Inter',sans-serif;
  display:flex;
  align-items:center;
}

.spv-inner{
  width:100%;
  padding:0px 10px;
}

/* Header */

.spv-head{
  text-align:center;
}

.spv-pill{
  display:inline-block;
  background:#f3dcc7;
  color:#d96b1a;
  padding:8px 24px;
  line-height:1;
  border-radius:25px;
  font-size: calc(var(--typeHeaderSize) * 0.66);
  font-weight:600;
  letter-spacing:1px;
}

.spv-head h2{
  margin:10px 0;
  font-size: var(--typeHeaderSize);
  font-weight:700;
  color:#0b2a5b;
}

/* Divider */

.spv-mid-line{
  height:1px;
  background:#dcdfe5;
  margin-bottom:0;
}

/* Rows */

.spv-row{
  display:grid;
  grid-template-columns:1fr 1px 1fr;
  align-items:center;
  padding:15px 0;
}

.spv-row + .spv-row{
  border-top:1px solid #dcdfe5;
}

.spv-divider{
  width:1px;
  height:100%;
  background:#dcdfe5;
}

.spv-item{
  text-align:center;
  padding:0 20px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:space-between;
}

.spv-ic{
  font-size:24px;
  line-height:1;
  margin-bottom:5px;
}

.spv-item h4{
  font-size: calc(var(--typeHeaderSize) * 0.78);
  line-height:1.2;
  font-weight:600;
  color:#0b2a5b;
  margin:0;
}

.spv-item span{
  border-bottom:3px solid #ff7a00;
}

.spv-item p{
  margin-top:8px;
  font-size: calc(var(--typeHeaderSize) * 0.61);
  color:#5c6a7c;
}


/* ===============================
TIMELINE
================================ */

.spv-time{
  max-width:1100px;
  margin:18px auto 10px;
  padding:0 12px;
}

.spv-tl{
  display:grid;
  grid-template-columns:repeat(6, 1fr);
  align-items:start;
}

/* Labels */

.spv-label{
  text-align:center;
  font-size: calc(var(--typeHeaderSize) * 0.55);
  line-height:1.15;
  color:#0b2a5b;
  font-weight:600;
  min-width:0;
  white-space:normal;
  word-break:break-word;
}

/* Timeline Track */

.spv-track{
  position:relative;
  height:22px;
  margin-top:10px;
}

.spv-track::before{
  content:"";
  position:absolute;
  left:calc((100% / 6) / 10);
  right:calc((100% / 6) / 10);
  top:50%;
  transform:translateY(-50%);
  height:3px;
  background:#d7dbe3;
  border-radius:4px;
}

.spv-dots{
  position:absolute;
  inset:0;
  display:grid;
  grid-template-columns:repeat(6, 1fr);
  align-items:center;
}

.spv-dots span{
  width:10px;
  height:10px;
  background:#0b2a5b;
  border-radius:50%;
  justify-self:center;
}


/* Footer */

.spv-foot{
  margin-top:30px;
  text-align:center;
  font-size: calc(var(--typeHeaderSize) * 0.66);
  color:#0b2a5b;
  background:#e7e7e7;
  padding:5px 0;
}


/* ===============================
MOBILE
================================ */

@media(max-width:575px){

.spv-tl{
  grid-template-columns:repeat(3,1fr);
}

.spv-track{
  display:none;
}

.spv-item h4{
  font-size: calc(var(--typeHeaderSize) * 0.72);
}

.spv-item p{
  font-size: var(--typeBaseSize);
}

.spv-foot{
  margin-bottom:30px;
}

}

@media(max-width:475px){

.spv-row{
  grid-template-columns:1fr;
  padding:20px 0;
}

.spv-divider{
  height:1px;
  margin:20px auto;
  width:100%;
}

.spv-row:last-child{
  padding-bottom:0;
}

.spv-head h2{
  font-size: calc(var(--typeHeaderSize) * 0.9);
}

.spv-pill{
  padding:6px 16px;
  font-size: calc(var(--typeHeaderSize) * 0.45);
}

}

</style>
    

    

