  $('.js-load-more').on('click', function(){
	var $this =$(this),
	totalPages = parseInt($('[data-all-pages]').val()),
	currentPage = parseInt($('[data-this-page]').val()),
	datacollurl = $('[data-coll-url]').val();;
	$this.attr('disabled', true);
	$this.find('[load-more-text]').addClass('hide');
	$this.find('[loader]').removeClass('hide');
	var nextUrl = $('[data-next-link]').val();
	var current_page_new = currentPage + 1;
	var next_coll = currentPage + 2;
    console.log(nextUrl)
	$.ajax({
      url: nextUrl,
      type: 'GET',
      dataType: 'html',
      error: function(e){
        console.log(e);
      },
      success: function(responseHTML){
        var divs = $(responseHTML).find('#CollectionAjaxContent .grid--uniform').html();
        $('[data-next-link]').val(datacollurl + "?page="+next_coll);
        $('[data-this-page]').val(current_page_new);
        $('#CollectionAjaxContent .grid--uniform').append(divs);
        $('#CollectionAjaxContent .grid--uniform .watch-types').eq(1).remove();
        $('#CollectionAjaxContent .grid--uniform .grid__item .grid-product__meta .jdgm-preview-badge .jdgm-prev-badge').each(function(){
          var reviewString = $(this).data("average-rating") + " (" + $(this).data("number-of-reviews") + ")";
          $(this).find("span.jdgm-prev-badge__text").text(reviewString)
        })
      },
      complete: function(source) {
        if(current_page_new < totalPages) {
          $this.attr('disabled', false); $this.find('[load-more-text]').removeClass('hide'); $this.find('[loader]').addClass('hide');
        } 
        if(current_page_new >= totalPages) {
          $this.find('[load-more-text]').text("That's all New Designs will come soon.").removeClass('hide'); $this.find('[loader]').addClass('hide');
        } 
      }
	})
  });

  
  function DOMready(callback) {
